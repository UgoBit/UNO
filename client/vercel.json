{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd .. && npm run build -w client",
  "outputDirectory": "dist",
  "installCommand": "cd .. && NPM_CONFIG_PRODUCTION=false npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
